<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.unpri.charactermanager.controller.CharacterController"
            prefWidth="750"
            prefHeight="550"
            style="-fx-background-color: #172033;">

    <top>
        <VBox spacing="15" style="-fx-padding: 25;">

            <Label text="CHARACTER MANAGER"
                   style="-fx-font-size: 25px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Kelola karakter game Anda"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #aab7ca;"/>

            <HBox spacing="10">

                <TextField fx:id="nameField"
                           promptText="Nama karakter"
                           HBox.hgrow="ALWAYS"/>

                <ChoiceBox fx:id="typeChoiceBox"
                           prefWidth="130"/>

                <TextField fx:id="levelField"
                           promptText="Level"
                           prefWidth="90"/>

            </HBox>

            <HBox spacing="10">

                <Button fx:id="saveButton"
                        text="Simpan Karakter"
                        onAction="#handleSave"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>

                <Button fx:id="resetButton"
                        text="Reset"
                        onAction="#handleReset"
                        style="-fx-background-color: #475569;
                               -fx-text-fill: white;"/>

            </HBox>

        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #172033;
                           -fx-background-color: #172033;">

            <VBox fx:id="characterCardArea"
                  spacing="10"
                  style="-fx-padding: 20;
                         -fx-background-color: #172033;"/>

        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-padding: 15;
                     -fx-background-color: #263449;">

            <Label fx:id="statusBar"
                   text="Aplikasi siap digunakan."
                   style="-fx-text-fill: white;"
                   HBox.hgrow="ALWAYS"/>

            <Label fx:id="averageLevelLabel"
                   text="Rata-rata level: 0.0"
                   style="-fx-text-fill: white;
                          -fx-font-weight: bold;"/>

        </HBox>
    </bottom>

</BorderPane>
